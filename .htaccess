# ---------------------------------------------------------------
# Uptime Command — Apache / LiteSpeed hardening (cPanel)
# ---------------------------------------------------------------
Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block hidden files & folders (.git, .env, .htaccess …)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  # Block internal folders
  RewriteRule ^(app|storage)(/|$) - [F,L]
  # Block sensitive file types
  RewriteRule \.(sqlite|sqlite3|db|log|md|lock|sql|ini|sh|bak|json|dist)$ - [F,L,NC]
</IfModule>

<FilesMatch "(^\.|\.(sqlite|sqlite3|db|log|md|lock|sql|ini|sh|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
