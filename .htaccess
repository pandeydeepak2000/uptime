# ---------------------------------------------------------------
# Uptime Command — Apache / LiteSpeed hardening (cPanel)
# ---------------------------------------------------------------
Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block hidden files & folders (.git, .env, .htaccess …)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  # Block internal folders
  RewriteRule ^(app|storage)(/|$) - [F,L]
  # Block sensitive file types
  RewriteRule \.(sqlite|sqlite3|db|log|md|lock|sql|ini|sh|bak|json|dist|zip|tar|gz|tgz|rar|7z)$ - [F,L,NC]

  # ---- Clean URLs: /login instead of /login.php ----
  # Tell PHP rewriting works, so the app prints links without .php
  RewriteRule ^ - [E=CLEAN_URLS:1]
  # Old address typed or bookmarked (GET only — form posts are never redirected):
  #   /login.php?x=1  →  /login?x=1   (api, cron, installer and index keep .php)
  RewriteCond %{REQUEST_URI} !/(index|api|cron|install)\.php$ [NC]
  RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s/([^?\s]*?)([a-z_]+)\.php(?:[?\s]) [NC]
  RewriteRule ^ /%1%2 [R=302,L]
  # /login  →  runs login.php (only if that file really exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z_]+)$ $1.php [L]
</IfModule>

<FilesMatch "(^\.|\.(sqlite|sqlite3|db|log|md|lock|sql|ini|sh|bak|zip|tar|gz|tgz|rar|7z)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
